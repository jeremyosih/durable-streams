{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@durable-streams/server": ["../server/src/index.ts"],
      "@durable-streams/server/*": ["../server/src/*"],
      "@durable-streams/client": ["../client/src/index.ts"],
      "@durable-streams/client/*": ["../client/src/*"],
      "@durable-streams/state": ["../state/src/index.ts"],
      "@durable-streams/state/*": ["../state/src/*"],
      "@durable-streams/server-conformance-tests": [
        "../server-conformance-tests/src/index.ts"
      ]
    }
  },
  "include": ["src/**/*", "test/**/*", "*.ts"],
  "exclude": ["node_modules", "dist"]
}
